@model ChargeListViewModel
@{
    const string cols = "1fr 1.5fr 1fr 1fr auto";
    const string emptyMessage = "Aucune charge — cliquez sur Nouveau pour commencer.";
    var pagination = new ListPaginationViewModel
    {
        Page = Model.Page,
        TotalPages = Model.TotalPages,
        HasPrevious = Model.HasPrevious,
        HasNext = Model.HasNext,
        Search = Model.Search
    };
}

<partial name="_DashboardAlerts" />

<div class="page-head">
    <p class="eyebrow">Achat</p>
    <h1>Charges</h1>
    <p class="module-section">Frais liés aux achats et à l'exploitation</p>
</div>

<form method="get" asp-action="Index" class="list-toolbar">
    <a asp-action="Create" class="btn btn-primary">Nouveau</a>
    <input type="search"
           class="list-search"
           name="search"
           value="@Model.Search"
           placeholder="Rechercher par libellé ou type…"
           autocomplete="off" />
</form>

<div class="list-wrap">
    <div class="list-header" style="grid-template-columns:@cols">
        <span>Type</span>
        <span>Libellé</span>
        <span>Date</span>
        <span class="cell-bold">Montant TTC</span>
        <span>Actions</span>
    </div>
    <div class="list-body">
        @if (Model.Items.Count == 0)
        {
            <partial name="_ListEmpty" model="emptyMessage" />
        }
        else
        {
            foreach (var charge in Model.Items)
            {
                var linkedToIntervention = charge.InterventionId.HasValue;

                <div class="list-row" style="grid-template-columns:@cols">
                    <span data-label="Type">@charge.TypeChargeNom</span>
                    <span data-label="Libellé">
                        @if (linkedToIntervention)
                        {
                            @charge.Libelle
                        }
                        else
                        {
                            <a asp-action="Edit" asp-route-id="@charge.Id" class="list-link">@charge.Libelle</a>
                        }
                    </span>
                    <span data-label="Date">@charge.Date.ToString("dd/MM/yyyy")</span>
                    <span data-label="Montant TTC" class="cell-bold">@charge.MontantTtc.ToString("N2") DH</span>
                    <span class="list-row-actions" data-label="Actions">
                        @if (linkedToIntervention)
                        {
                            <button type="button"
                                    class="btn btn-icon"
                                    disabled
                                    aria-label="Modifier">
                                <partial name="~/Views/Shared/Icons/Edit.cshtml" />
                            </button>
                        }
                        else
                        {
                            <a asp-action="Edit"
                               asp-route-id="@charge.Id"
                               class="btn btn-icon"
                               title="Modifier"
                               aria-label="Modifier">
                                <partial name="~/Views/Shared/Icons/Edit.cshtml" />
                            </a>
                        }
                    </span>
                </div>
            }
        }
    </div>
</div>

<partial name="_ListPagination" model="pagination" />
