@model ChargeFormViewModel
@using System.Globalization

<form asp-action="@(Model.IsEdit ? "Edit" : "Create")"
      asp-route-id="@Model.Id"
      method="post"
      class="form-grid">
    @Html.AntiForgeryToken()
    <div asp-validation-summary="ModelOnly" class="form-validation-summary"></div>

    <div class="form-field">
        <label asp-for="TypeChargeId">Type</label>
        <select asp-for="TypeChargeId">
            <option value="">— Sélectionner —</option>
            @foreach (var type in Model.TypeCharges)
            {
                <option value="@type.Id">@type.Nom</option>
            }
        </select>
        <span asp-validation-for="TypeChargeId" class="field-validation-error"></span>
    </div>

    <div class="form-field">
        <label asp-for="Libelle">Libellé</label>
        <input asp-for="Libelle" />
        <span asp-validation-for="Libelle" class="field-validation-error"></span>
    </div>

    <div class="form-field">
        <label asp-for="Date">Date</label>
        <input asp-for="Date" type="date" />
        <span asp-validation-for="Date" class="field-validation-error"></span>
    </div>

    <div class="form-field">
        <label asp-for="MontantTtc">Montant TTC</label>
        <input asp-for="MontantTtc"
               type="number"
               step="0.01"
               min="0.01"
               value="@Model.MontantTtc.ToString(CultureInfo.InvariantCulture)" />
        <span asp-validation-for="MontantTtc" class="field-validation-error"></span>
    </div>

    <div class="form-field">
        <label asp-for="Note">Note</label>
        <textarea asp-for="Note" rows="5"></textarea>
        <span asp-validation-for="Note" class="field-validation-error"></span>
    </div>

    <div class="form-toolbar">
        <button type="submit" class="btn btn-primary">Enregistrer</button>
        <a asp-action="Index" class="btn">Annuler</a>
    </div>
</form>
