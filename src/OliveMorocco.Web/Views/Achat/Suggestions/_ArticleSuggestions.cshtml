@model IReadOnlyList<OliveMorocco.Business.DTOs.Achat.ArticleSuggestionDto>
@using System.Globalization

@if (Model.Count == 0)
{
    <p class="doc-suggest-empty">Aucun article trouvé.</p>
}
else
{
    <ul class="doc-suggest-list">
        @foreach (var article in Model)
        {
            <li>
                <button type="button"
                        class="article-suggestion doc-suggest-item"
                        data-produit-id="@article.ProduitId"
                        data-reference="@article.Reference"
                        data-designation="@article.Designation"
                        data-unite="@article.Unite"
                        data-prix="@article.PrixUnitaireHT.ToString(CultureInfo.InvariantCulture)"
                        data-tva="@article.TauxTVA.ToString(CultureInfo.InvariantCulture)">
                    <span class="doc-suggest-ref">@article.Reference</span>
                    <span class="doc-suggest-label">@article.Designation</span>
                </button>
            </li>
        }
    </ul>
}
