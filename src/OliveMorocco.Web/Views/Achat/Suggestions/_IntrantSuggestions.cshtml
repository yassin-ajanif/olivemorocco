@model IReadOnlyList<OliveMorocco.Business.DTOs.Achat.IntrantSuggestionDto>

@if (Model.Count == 0)
{
    <p class="doc-suggest-empty">Aucun intrant trouvé.</p>
}
else
{
    <ul class="doc-suggest-list">
        @foreach (var intrant in Model)
        {
            <li>
                <button type="button"
                        class="intrant-suggestion doc-suggest-item"
                        data-intrant-id="@intrant.IntrantId"
                        data-nom="@intrant.Nom"
                        data-unite="@intrant.Unite">
                    <span class="doc-suggest-ref">@intrant.Unite</span>
                    <span class="doc-suggest-label">@intrant.Nom</span>
                </button>
            </li>
        }
    </ul>
}
