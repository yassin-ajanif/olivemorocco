@model InterventionFormViewModel

<partial name="_DashboardAlerts" />

<div class="page-head">
    <p class="eyebrow"><partial name="_TrLabel" model="@("Opérationnel · Interventions")" /></p>
    <h1>@(Model.SecteurNom ?? "Intervention") — @Model.Date.ToString("dd/MM/yyyy")</h1>
    <p class="form-ref">Réf. intervention <strong>@Model.Numero</strong></p>
</div>

<div class="form-panel form-panel-ops">
    <partial name="_InterventionForm" model="Model" />
</div>

<form asp-action="Delete"
      asp-route-id="@Model.Id"
      method="post"
      class="form-delete"
      onsubmit="return confirm('Supprimer cette intervention ?');">
    @Html.AntiForgeryToken()
    <button type="submit" class="btn btn-danger"><partial name="_TrLabel" model="@("Supprimer")" /></button>
</form>

@section Scripts {
    <script src="~/js/intervention-form.js" asp-append-version="true"></script>
}
