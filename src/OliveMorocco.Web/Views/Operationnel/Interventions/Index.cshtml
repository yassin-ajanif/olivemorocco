@model InterventionListViewModel
@{
    const string cols = "1fr 1.2fr 1.2fr 1fr 0.8fr 1fr auto";
    const string emptyMessage = "Aucune intervention — cliquez sur Nouveau pour commencer.";
    var pagination = new ListPaginationViewModel
    {
        Page = Model.Page,
        TotalPages = Model.TotalPages,
        HasPrevious = Model.HasPrevious,
        HasNext = Model.HasNext,
        Search = Model.Search
    };
}

<partial name="_DashboardAlerts" />

<div class="page-head">
    <p class="eyebrow">Opérationnel</p>
    <h1>Interventions</h1>
    <p class="module-section">Opérations terrain par secteur (intrants, irrigation, coûts)</p>
</div>

<form method="get" asp-action="Index" class="list-toolbar">
    <a asp-action="Create" class="btn btn-primary">Nouveau</a>
    <input type="search"
           class="list-search"
           name="search"
           value="@Model.Search"
           placeholder="Rechercher par secteur, intrant ou note…"
           autocomplete="off" />
</form>

<div class="list-wrap">
    <div class="list-header" style="grid-template-columns:@cols">
        <span>Date</span>
        <span>Secteur</span>
        <span>Intrant</span>
        <span>Qté intrant</span>
        <span>Eau (m³)</span>
        <span class="cell-bold">Coûts</span>
        <span>Actions</span>
    </div>
    <div class="list-body">
        @if (Model.Items.Count == 0)
        {
            <partial name="_ListEmpty" model="emptyMessage" />
        }
        else
        {
            foreach (var item in Model.Items)
            {
                var qtyLabel = item.QuantiteIntrant.HasValue && !string.IsNullOrEmpty(item.IntrantUnite)
                    ? $"{item.QuantiteIntrant.Value:N2} {item.IntrantUnite}"
                    : item.QuantiteIntrant.HasValue
                        ? item.QuantiteIntrant.Value.ToString("N2")
                        : "—";
                var eauLabel = item.QuantiteEau.HasValue ? item.QuantiteEau.Value.ToString("N2") : "—";

                <div class="list-row" style="grid-template-columns:@cols">
                    <span data-label="Date">
                        <a asp-action="Edit" asp-route-id="@item.Id" class="list-link">@item.Date.ToString("dd/MM/yyyy")</a>
                    </span>
                    <span data-label="Secteur">@item.SecteurNom</span>
                    <span data-label="Intrant">@(item.IntrantNom ?? "—")</span>
                    <span data-label="Qté intrant">@qtyLabel</span>
                    <span data-label="Eau (m³)">@eauLabel</span>
                    <span data-label="Coûts" class="cell-bold">@item.TotalCharges.ToString("N2") DH</span>
                    <span class="list-row-actions" data-label="Actions">
                        <a asp-action="Edit"
                           asp-route-id="@item.Id"
                           class="btn btn-icon"
                           title="Modifier"
                           aria-label="Modifier">
                            <partial name="~/Views/Shared/Icons/Edit.cshtml" />
                        </a>
                    </span>
                </div>
            }
        }
    </div>
</div>

<partial name="_ListPagination" model="pagination" />
