@model InterventionListViewModel
@{
    const string cols = "1fr 1.2fr 1.2fr 2fr 0.8fr 1fr auto";
    const string emptyMessage = "Aucune intervention — cliquez sur Nouveau pour commencer.";
    var pagination = new ListPaginationViewModel
    {
        Page = Model.Page,
        TotalPages = Model.TotalPages,
        HasPrevious = Model.HasPrevious,
        HasNext = Model.HasNext,
        Search = Model.Search
    };
}

<partial name="_DashboardAlerts" />

<div class="page-head">
    <p class="eyebrow"><partial name="_TrLabel" model="@("Opérationnel")" /></p>
    <h1><partial name="_TrLabel" model="@("Interventions")" /></h1>
    <p class="module-section"><partial name="_TrLabel" model="@("Opérations terrain par secteur (intrants, irrigation, coûts)")" /></p>
</div>

<form method="get" asp-action="Index" class="list-toolbar">
    <a asp-action="Create" class="btn btn-primary"><partial name="_TrLabel" model="@("Nouveau")" /></a>
    <input type="search"
           class="list-search"
           name="search"
           value="@Model.Search"
           placeholder="Rechercher par secteur, intrant ou note…" data-tr-ar="@(Translations.For("Rechercher par secteur, intrant ou note…"))"
           autocomplete="off" />
</form>

<div class="list-wrap">
    <div class="list-header" style="grid-template-columns:@cols">
        <span><partial name="_TrLabel" model="@("Date")" /></span>
        <span><partial name="_TrLabel" model="@("N°")" /></span>
        <span><partial name="_TrLabel" model="@("Secteur")" /></span>
        <span><partial name="_TrLabel" model="@("Intrants")" /></span>
        <span><partial name="_TrLabel" model="@("Eau (m³)")" /></span>
        <span class="cell-bold"><partial name="_TrLabel" model="@("Coûts")" /></span>
        <span><partial name="_TrLabel" model="@("Actions")" /></span>
    </div>
    <div class="list-body">
        @if (Model.Items.Count == 0)
        {
            <partial name="_ListEmpty" model="emptyMessage" />
        }
        else
        {
            foreach (var item in Model.Items)
            {
                var eauLabel = item.QuantiteEau.HasValue ? item.QuantiteEau.Value.ToString("N2") : "—";

                <div class="list-row" style="grid-template-columns:@cols">
                    <span data-label="Date" data-label-ar="@(Translations.For("Date"))">
                        <a asp-action="Edit" asp-route-id="@item.Id" class="list-link">@item.Date.ToString("dd/MM/yyyy")</a>
                    </span>
                    <span data-label="N°" data-label-ar="@(Translations.For("N°"))">@item.Numero</span>
                    <span data-label="Secteur" data-label-ar="@(Translations.For("Secteur"))">@item.SecteurNom</span>
                    <span data-label="Intrants" data-label-ar="@(Translations.For("Intrants"))">@item.IntrantSummary</span>
                    <span data-label="Eau (m³)" data-label-ar="@(Translations.For("Eau (m³)"))">@eauLabel</span>
                    <span data-label="Coûts" data-label-ar="@(Translations.For("Coûts"))" class="cell-bold">@item.TotalCharges.ToString("N2") DH</span>
                    <span class="list-row-actions" data-label="Actions" data-label-ar="@(Translations.For("Actions"))">
                        <a asp-action="Edit"
                           asp-route-id="@item.Id"
                           class="btn btn-icon"
                           title="Modifier" data-tr-ar="@(Translations.For("Modifier"))"
                           aria-label="Modifier" data-tr-ar="@(Translations.For("Modifier"))">
                            <partial name="~/Views/Shared/Icons/Edit.cshtml" />
                        </a>
                    </span>
                </div>
            }
        }
    </div>
</div>

<partial name="_ListPagination" model="pagination" />
