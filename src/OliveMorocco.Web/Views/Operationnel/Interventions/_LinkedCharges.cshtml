@model InterventionFormViewModel
@using OliveMorocco.Web.Routing

<div class="form-panel ops-linked-charges">
    <div class="ops-linked-charges-head">
        <h2 class="ops-linked-charges-title">Charges liées</h2>
        <a href="/@AppSections.Achat/Charges/Create" class="btn btn-sm">Ajouter une charge</a>
    </div>

    @if (Model.LinkedCharges.Count == 0)
    {
        <p class="ops-linked-charges-empty">Aucune charge liée à cette intervention.</p>
    }
    else
    {
        <div class="list-wrap ops-linked-charges-list">
            <div class="list-header" style="grid-template-columns:1fr 1.5fr 1fr 1fr auto">
                <span>Type</span>
                <span>Libellé</span>
                <span>Date</span>
                <span class="cell-bold">Montant TTC</span>
                <span>Actions</span>
            </div>
            <div class="list-body">
                @foreach (var charge in Model.LinkedCharges)
                {
                    <div class="list-row" style="grid-template-columns:1fr 1.5fr 1fr 1fr auto">
                        <span data-label="Type">@charge.TypeChargeNom</span>
                        <span data-label="Libellé">@charge.Libelle</span>
                        <span data-label="Date">@charge.Date.ToString("dd/MM/yyyy")</span>
                        <span data-label="Montant TTC" class="cell-bold">@charge.MontantTtc.ToString("N2") DH</span>
                        <span class="list-row-actions" data-label="Actions">
                            <a href="/@AppSections.Achat/Charges/Edit/@charge.Id"
                               class="btn btn-icon"
                               title="Modifier la charge"
                               aria-label="Modifier la charge">
                                <partial name="~/Views/Shared/Icons/Edit.cshtml" />
                            </a>
                        </span>
                    </div>
                }
            </div>
        </div>

        <p class="ops-linked-charges-total">
            Total coûts : <strong>@Model.TotalCharges.ToString("N2") DH</strong>
        </p>
    }
</div>
