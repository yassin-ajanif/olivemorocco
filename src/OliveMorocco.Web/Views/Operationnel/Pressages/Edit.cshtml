@model PressageFormViewModel

<partial name="_DashboardAlerts" />

<div class="page-head">
    <p class="eyebrow"><partial name="_TrLabel" model="@("Opérationnel · Pressages")" /></p>
    <h1>Pressage @(Model.Numero ?? string.Empty)</h1>
    <p class="form-ref">Réf. pressage <strong>@Model.Numero</strong></p>
</div>

<div class="form-panel form-panel-ops">
    <partial name="_PressageForm" model="Model" />
</div>

@section Scripts {
    <script src="~/js/pressage-form.js" asp-append-version="true"></script>
}
