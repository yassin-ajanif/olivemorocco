@model PressageListViewModel
@{
    const string cols = "1fr 1.2fr 1.4fr 1fr 0.9fr 0.8fr 0.8fr auto";
    const string emptyMessage = "Aucun pressage — cliquez sur Nouveau pour commencer.";
    var pagination = new ListPaginationViewModel
    {
        Page = Model.Page,
        TotalPages = Model.TotalPages,
        HasPrevious = Model.HasPrevious,
        HasNext = Model.HasNext,
        Search = Model.Search
    };
}

<partial name="_DashboardAlerts" />

<div class="page-head">
    <p class="eyebrow"><partial name="_TrLabel" model="@("Opérationnel")" /></p>
    <h1><partial name="_TrLabel" model="@("Pressages")" /></h1>
    <p class="module-section"><partial name="_TrLabel" model="@("Pressage des olives à l'huilerie — rendement et facturation")" /></p>
</div>

<form method="get" asp-action="Index" class="list-toolbar">
    <a asp-action="Create" class="btn btn-primary"><partial name="_TrLabel" model="@("Nouveau")" /></a>
    <input type="search"
           class="list-search"
           name="search"
           value="@Model.Search"
           placeholder="Rechercher par huilerie, variété ou facture…" data-tr-ar="@(Translations.For("Rechercher par huilerie, variété ou facture…"))"
           autocomplete="off" />
</form>

<div class="list-wrap">
    <div class="list-header" style="grid-template-columns:@cols">
        <span><partial name="_TrLabel" model="@("Date")" /></span>
        <span><partial name="_TrLabel" model="@("N°")" /></span>
        <span><partial name="_TrLabel" model="@("Huilerie")" /></span>
        <span><partial name="_TrLabel" model="@("Variété")" /></span>
        <span class="cell-bold"><partial name="_TrLabel" model="@("Olives (kg)")" /></span>
        <span class="cell-bold"><partial name="_TrLabel" model="@("Rendement")" /></span>
        <span class="cell-bold"><partial name="_TrLabel" model="@("Huile (L)")" /></span>
        <span><partial name="_TrLabel" model="@("Actions")" /></span>
    </div>
    <div class="list-body">
        @if (Model.Items.Count == 0)
        {
            <partial name="_ListEmpty" model="emptyMessage" />
        }
        else
        {
            foreach (var item in Model.Items)
            {
                var huileLabel = item.QuantiteHuile.HasValue ? item.QuantiteHuile.Value.ToString("N2") : "—";

                <div class="list-row" style="grid-template-columns:@cols">
                    <span data-label="Date" data-label-ar="@(Translations.For("Date"))">
                        <a asp-action="Edit" asp-route-id="@item.Id" class="list-link">@item.Date.ToString("dd/MM/yyyy")</a>
                    </span>
                    <span data-label="N°" data-label-ar="@(Translations.For("N°"))">@item.Numero</span>
                    <span data-label="Huilerie" data-label-ar="@(Translations.For("Huilerie"))">@item.FournisseurNom</span>
                    <span data-label="Variété" data-label-ar="@(Translations.For("Variété"))">@item.VarieteNom</span>
                    <span data-label="Olives (kg)" data-label-ar="@(Translations.For("Olives (kg)"))" class="cell-bold">@item.QuantiteOlives.ToString("N2")</span>
                    <span data-label="Rendement" data-label-ar="@(Translations.For("Rendement"))" class="cell-bold">@item.Rendement.ToString("N2") %</span>
                    <span data-label="Huile (L)" data-label-ar="@(Translations.For("Huile (L)"))" class="cell-bold">@huileLabel</span>
                    <span class="list-row-actions" data-label="Actions" data-label-ar="@(Translations.For("Actions"))">
                        <a asp-action="Edit"
                           asp-route-id="@item.Id"
                           class="btn btn-icon"
                           title="Modifier" data-tr-ar="@(Translations.For("Modifier"))"
                           aria-label="Modifier" data-tr-ar="@(Translations.For("Modifier"))">
                            <partial name="~/Views/Shared/Icons/Edit.cshtml" />
                        </a>
                    </span>
                </div>
            }
        }
    </div>
</div>

<partial name="_ListPagination" model="pagination" />
