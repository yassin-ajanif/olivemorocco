@model PressageFormViewModel

<form asp-action="@(Model.IsEdit ? "Edit" : "Create")"
      asp-route-id="@Model.Id"
      method="post"
      class="form-grid pressage-form"
      id="pressageForm"
      data-pressage-form>
    @Html.AntiForgeryToken()
    <div asp-validation-summary="All" class="form-validation-summary"></div>

    <div class="ops-form-row-2">
        <div class="form-field">
            <label for="FournisseurId"><partial name="_TrLabel" model="@("Huilerie")" /></label>
            <select asp-for="FournisseurId" id="FournisseurId" data-pressage-fournisseur>
                <option value="" data-tr-ar="@(Translations.For("— Sélectionner —"))">— Sélectionner —</option>
                @foreach (var fournisseur in Model.Fournisseurs)
                {
                    <option value="@fournisseur.Id">@fournisseur.Nom</option>
                }
            </select>
            <span asp-validation-for="FournisseurId" class="field-validation-error"></span>
        </div>

        <div class="form-field">
            <label for="VarieteId"><partial name="_TrLabel" model="@("Variété")" /></label>
            <select asp-for="VarieteId">
                <option value="" data-tr-ar="@(Translations.For("— Sélectionner —"))">— Sélectionner —</option>
                @foreach (var variete in Model.Varietes)
                {
                    <option value="@variete.Id">@variete.Nom</option>
                }
            </select>
            <span asp-validation-for="VarieteId" class="field-validation-error"></span>
        </div>
    </div>

    <div class="ops-form-row-2">
        <div class="form-field">
            <label for="Date"><partial name="_TrLabel" model="@("Date")" /></label>
            <input asp-for="Date" type="date" />
            <span asp-validation-for="Date" class="field-validation-error"></span>
        </div>
    </div>

    <div class="ops-form-row-3">
        <div class="form-field">
            <label for="QuantiteOlives"><partial name="_TrLabel" model="@("Quantité d'olives (kg)")" /></label>
            <input asp-for="QuantiteOlives"
                   type="number"
                   step="1"
                   min="0"
                   id="QuantiteOlives"
                   data-pressage-olives />
            <span asp-validation-for="QuantiteOlives" class="field-validation-error"></span>
        </div>

        <div class="form-field">
            <label for="Rendement"><partial name="_TrLabel" model="@("Rendement (%)")" /></label>
            <input asp-for="Rendement"
                   type="number"
                   step="1"
                   min="0"
                   max="100"
                   id="Rendement"
                   data-pressage-rendement />
            <span asp-validation-for="Rendement" class="field-validation-error"></span>
        </div>

        <div class="form-field">
            <label for="QuantiteHuile"><partial name="_TrLabel" model="@("Quantité d'huile (L)")" /></label>
            <input asp-for="QuantiteHuile"
                   type="number"
                   step="1"
                   min="0"
                   id="QuantiteHuile"
                   data-pressage-huile />
            <p class="pressage-form-hint"><partial name="_TrLabel" model="@("Laisser vide pour calculer automatiquement (olives × rendement).")" /></p>
            <span asp-validation-for="QuantiteHuile" class="field-validation-error"></span>
        </div>
    </div>

    <div class="ops-section-title"><partial name="_TrLabel" model="@("Charge associée")" /></div>

    @if (Model.ChargeId is > 0)
    {
        <p class="form-ref">
            Charge <strong>n° @Model.ChargeId</strong> — enregistrée dans Achat › Charges :
            <a asp-controller="Charges"
               asp-action="Edit"
               asp-route-id="@Model.ChargeId"
               class="list-link"><partial name="_TrLabel" model="@("voir la charge")" /></a>
        </p>
    }

    <div class="ops-form-row-3">
        <div class="form-field">
            <label for="TypeChargeId"><partial name="_TrLabel" model="@("Type de charge")" /></label>
            <select asp-for="TypeChargeId" id="TypeChargeId">
                <option value="" data-tr-ar="@(Translations.For("— Sélectionner —"))">— Sélectionner —</option>
                @foreach (var type in Model.TypeCharges)
                {
                    <option value="@type.Id">@type.Nom</option>
                }
            </select>
            <span asp-validation-for="TypeChargeId" class="field-validation-error"></span>
        </div>

        <div class="form-field">
            <label for="Libelle"><partial name="_TrLabel" model="@("Libellé")" /></label>
            <input asp-for="Libelle" type="text" id="Libelle" />
            <span asp-validation-for="Libelle" class="field-validation-error"></span>
        </div>

        <div class="form-field">
            <label for="ChargeDate"><partial name="_TrLabel" model="@("Date de la charge")" /></label>
            <input asp-for="ChargeDate" type="date" id="ChargeDate" />
            <span asp-validation-for="ChargeDate" class="field-validation-error"></span>
        </div>
    </div>

    <div class="ops-form-row-2">
        <div class="form-field">
            <label for="MontantTtc"><partial name="_TrLabel" model="@("Montant TTC")" /></label>
            <input asp-for="MontantTtc" type="number" step="0.01" min="0" id="MontantTtc" />
            <span asp-validation-for="MontantTtc" class="field-validation-error"></span>
        </div>

        <div class="form-field">
            <label for="Note"><partial name="_TrLabel" model="@("Note")" /></label>
            <input asp-for="Note" type="text" id="Note" />
            <span asp-validation-for="Note" class="field-validation-error"></span>
        </div>
    </div>

    <div class="form-toolbar">
        <button type="submit" class="btn btn-primary"><partial name="_TrLabel" model="@("Enregistrer")" /></button>
        <a asp-action="Index" class="btn"><partial name="_TrLabel" model="@("Annuler")" /></a>
        @if (Model.IsEdit)
        {
            <button type="submit"
                    formaction="@Url.Action("Delete", new { id = Model.Id })"
                    formmethod="post"
                    class="btn btn-danger"
                    onclick="return confirm('Supprimer ce pressage ?');"><partial name="_TrLabel" model="@("Supprimer")" /></button>
        }
    </div>
</form>
