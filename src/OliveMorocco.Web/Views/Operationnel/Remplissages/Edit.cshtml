@model RemplissageFormViewModel

<partial name="_DashboardAlerts" />

<div class="page-head">
    <p class="eyebrow"><partial name="_TrLabel" model="@("Opérationnel · Remplissages")" /></p>
    <h1>Remplissage @Model.Numero</h1>
    <p class="form-ref">Réf. remplissage <strong>#@Model.Id</strong></p>
</div>

<div class="form-panel form-panel-ops">
    <partial name="_RemplissageForm" model="Model" />
</div>

@section Scripts {
    <script src="~/js/remplissage-form.js" asp-append-version="true"></script>
}
