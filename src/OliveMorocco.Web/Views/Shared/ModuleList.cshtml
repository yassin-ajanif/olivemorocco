@model ModuleListPageViewModel
@{
    Layout = "_DashboardLayout";
    ViewData["DashSection"] = Model.Section switch
    {
        "Vente" => "vente",
        "Achat" => "achat",
        _ => ""
    };
    ViewData["DashModule"] = Model.ModuleKey;
    ViewData["Title"] = Model.Title;
}

<partial name="_ModuleListPage" model="Model" />
