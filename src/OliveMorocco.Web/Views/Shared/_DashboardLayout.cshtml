@{
    var dashSection = ViewData["DashSection"] as string ?? "vente";
    var dashModule = ViewData["DashModule"] as string ?? "";
    string NavClass(string module) => dashModule == module ? "dash-item active" : "dash-item";
    string SectionClass(string section) => dashSection == section ? "dash-section open" : "dash-section";
    string SectionArrow(string section) => dashSection == section ? "▼" : "▶";
    string SectionExpanded(string section) => dashSection == section ? "true" : "false";
}
<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] — ZAHO Gestion</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,300;0,9..144,600;1,9..144,400;1,9..144,600&family=Work+Sans:wght@400;500;600&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>

<header class="dash-topbar">
    <div class="dash-topbar-brand">ZAHO <span>Gestion</span></div>
    <a class="dash-topbar-link" asp-controller="Home" asp-action="Index">← Accueil</a>
</header>

<div class="dash-layout">
    <aside class="dash-sidebar">
        <div class="dash-sidebar-inner">
            <p class="dash-user">Blad Atouaa Elmahdi</p>

            <nav class="dash-nav" id="dashNav">
                <div class="@SectionClass("vente")" data-section="vente">
                    <button type="button" class="dash-section-toggle" aria-expanded="@SectionExpanded("vente")">
                        <span class="arrow">@SectionArrow("vente")</span> Vente
                    </button>
                    <div class="dash-section-items">
                        <a asp-controller="Clients" asp-action="Index" class="@NavClass("clients")">Clients</a>
                        <a asp-controller="Devis" asp-action="Index" class="@NavClass("devis")">Devis</a>
                        <a asp-controller="BonsCommande" asp-action="Index" class="@NavClass("bons-commande")">Bons de commande</a>
                        <a asp-controller="BonsLivraison" asp-action="Index" class="@NavClass("bons-livraison")">Bons de livraison</a>
                        <a asp-controller="Facturation" asp-action="Index" class="@NavClass("facturation")">Facturation</a>
                        <a asp-controller="Avoirs" asp-action="Index" class="@NavClass("avoirs")">Avoirs</a>
                    </div>
                </div>

                <div class="@SectionClass("achat")" data-section="achat">
                    <button type="button" class="dash-section-toggle" aria-expanded="@SectionExpanded("achat")">
                        <span class="arrow">@SectionArrow("achat")</span> Achat
                    </button>
                    <div class="dash-section-items">
                        <a asp-controller="Fournisseurs" asp-action="Index" class="@NavClass("fournisseurs")">Fournisseurs</a>
                        <a asp-controller="BonsCommandeAchat" asp-action="Index" class="@NavClass("bons-commande-achat")">Bons de commande</a>
                        <a asp-controller="BonsReception" asp-action="Index" class="@NavClass("bons-reception")">Bons de réception</a>
                        <a asp-controller="FacturesFournisseurs" asp-action="Index" class="@NavClass("factures-fournisseurs")">Factures fournisseur</a>
                        <a asp-controller="AvoirFournisseur" asp-action="Index" class="@NavClass("avoir-fournisseur")">Avoir fournisseur</a>
                        <a asp-controller="Charges" asp-action="Index" class="@NavClass("charges")">Charges</a>
                    </div>
                </div>

                <div class="dash-section-spacer"></div>

                <div class="dash-section" data-section="operationnel">
                    <button type="button" class="dash-section-toggle" aria-expanded="false">
                        <span class="arrow">▶</span> Opérationnel
                    </button>
                </div>
            </nav>
        </div>
    </aside>

    <main class="dash-main" id="dashMain">@RenderBody()</main>
</div>

<script src="~/js/dashboard-nav.js" asp-append-version="true"></script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
