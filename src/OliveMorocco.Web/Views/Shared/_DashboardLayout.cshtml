@using OliveMorocco.Web.Routing
@{
    var nav = DashboardNav.Resolve(Context);
    var dashSection = nav?.Section ?? "vente";
    var dashModule = nav?.ModuleKey ?? "";
    var pageTitle = DashboardNav.PageTitle(Context, nav);
    string NavClass(string module) => dashModule == module ? "dash-item active" : "dash-item";
    string SectionClass(string section) => dashSection == section ? "dash-section open" : "dash-section";
    string SectionArrow(string section) => dashSection == section ? "▼" : "▶";
    string SectionExpanded(string section) => dashSection == section ? "true" : "false";
}
<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@pageTitle — ZAHO Gestion</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,300;0,9..144,600;1,9..144,400;1,9..144,600&family=Work+Sans:wght@400;500;600&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>

<header class="dash-topbar">
    <div class="dash-topbar-start">
        <button type="button"
                class="dash-nav-toggle"
                id="dashNavToggle"
                aria-controls="dashNav"
                aria-expanded="false"
                aria-label="Ouvrir le menu">
            <span class="dash-nav-toggle-bar" aria-hidden="true"></span>
            <span class="dash-nav-toggle-bar" aria-hidden="true"></span>
            <span class="dash-nav-toggle-bar" aria-hidden="true"></span>
        </button>
        <div class="dash-topbar-brand">ZAHO <span>Gestion</span></div>
    </div>
    <a class="dash-topbar-link" asp-controller="Home" asp-action="Index">← Accueil</a>
</header>

<button type="button" class="dash-nav-backdrop" id="dashNavBackdrop" hidden aria-label="Fermer le menu"></button>

<div class="dash-layout">
    <aside class="dash-sidebar">
        <div class="dash-sidebar-inner">
            <p class="dash-user">Blad Atouaa Elmahdi</p>

            <nav class="dash-nav" id="dashNav">
                <div class="@SectionClass("vente")" data-section="vente">
                    <button type="button" class="dash-section-toggle" aria-expanded="@SectionExpanded("vente")">
                        <span class="arrow">@SectionArrow("vente")</span> Vente
                    </button>
                    <div class="dash-section-items">
                        <a href="/@AppSections.Vente/Clients" class="@NavClass("clients")">Clients</a>
                        <a href="/@AppSections.Vente/Devis" class="@NavClass("devis")">Devis</a>
                        <a href="/@AppSections.Vente/BonsCommande" class="@NavClass("bons-commande")">Bons de commande</a>
                        <a href="/@AppSections.Vente/BonsLivraison" class="@NavClass("bons-livraison")">Bons de livraison</a>
                        <a href="/@AppSections.Vente/Facturation" class="@NavClass("facturation")">Facturation</a>
                        <a href="/@AppSections.Vente/Avoirs" class="@NavClass("avoirs")">Avoirs</a>
                    </div>
                </div>

                <div class="@SectionClass("achat")" data-section="achat">
                    <button type="button" class="dash-section-toggle" aria-expanded="@SectionExpanded("achat")">
                        <span class="arrow">@SectionArrow("achat")</span> Achat
                    </button>
                    <div class="dash-section-items">
                        <a href="/@AppSections.Achat/Fournisseurs" class="@NavClass("fournisseurs")">Fournisseurs</a>
                        <a href="/@AppSections.Achat/BonsCommande" class="@NavClass("bons-commande-achat")">Bons de commande</a>
                        <a href="/@AppSections.Achat/BonsReception" class="@NavClass("bons-reception")">Bons de réception</a>
                        <a href="/@AppSections.Achat/FacturesFournisseurs" class="@NavClass("factures-fournisseurs")">Factures fournisseur</a>
                        <a href="/@AppSections.Achat/AvoirFournisseur" class="@NavClass("avoir-fournisseur")">Avoir fournisseur</a>
                        <a href="/@AppSections.Achat/Charges" class="@NavClass("charges")">Charges</a>
                    </div>
                </div>

                <div class="dash-section-spacer"></div>

                <div class="dash-section" data-section="operationnel">
                    <button type="button" class="dash-section-toggle" aria-expanded="false">
                        <span class="arrow">▶</span> Opérationnel
                    </button>
                </div>
            </nav>
        </div>
    </aside>

    <main class="dash-main" id="dashMain">@RenderBody()</main>
</div>

<script src="~/js/dashboard-nav.js" asp-append-version="true"></script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
