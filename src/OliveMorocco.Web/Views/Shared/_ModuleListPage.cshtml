@model ModuleListPageViewModel

<div class="page-head">
    <p class="eyebrow">@Model.Section</p>
    <h1>@Model.Title</h1>
    <p class="module-section">@Model.Subtitle</p>
</div>

<div class="list-toolbar">
    <a asp-action="Create" class="btn btn-primary">Nouveau</a>
    <input type="search" class="list-search" name="q" placeholder="Rechercher…" disabled aria-disabled="true" title="Recherche disponible prochainement">
</div>

<div class="list-wrap">
    <div class="list-header" style="grid-template-columns:@Model.GridColumns">
        @foreach (var header in Model.Headers)
        {
            <span>@header</span>
        }
    </div>
    <div class="list-body">
        @if (Model.TotalCount == 0)
        {
            <div class="list-empty">Aucun enregistrement — cliquez sur Nouveau pour commencer.</div>
        }
    </div>
</div>

<div class="list-pagination">
    <div class="list-pagination-inner">
        <span class="total">@Model.TotalCount enregistrement@(Model.TotalCount != 1 ? "s" : "")</span>
        <div class="pagination-nav">
            <button type="button" disabled>⏮</button>
            <button type="button" disabled>‹</button>
            <span class="page-indicator"><b>1</b> / 1</span>
            <button type="button" disabled>›</button>
            <button type="button" disabled>⏭</button>
        </div>
    </div>
</div>
