@model HuileVracListViewModel
@{
    const string cols = "2fr 1fr 1fr auto minmax(5.5rem, auto)";
    const string emptyMessage = "Aucune variété — créez des variétés pour suivre l'huile en vrac.";
    var pagination = new ListPaginationViewModel
    {
        Page = Model.Page,
        TotalPages = Model.TotalPages,
        HasPrevious = Model.HasPrevious,
        HasNext = Model.HasNext,
        Search = Model.Search,
    };
}

<partial name="_DashboardAlerts" />

<div class="page-head">
    <p class="eyebrow">Stockage</p>
    <h1>Huile en vrac</h1>
    <p class="module-section">Huile issue des pressages, stockée par variété avant mise en bouteille</p>
</div>

<form method="get" asp-action="Index" class="list-toolbar">
    <input type="search"
           class="list-search"
           name="search"
           value="@Model.Search"
           placeholder="Rechercher par variété ou code…"
           autocomplete="off" />
</form>

<div class="list-wrap">
    <div class="list-header" style="grid-template-columns:@cols">
        <span>Variété</span>
        <span>Code</span>
        <span class="cell-bold cell-center">Stock (L)</span>
        <span>Statut</span>
        <span>Actions</span>
    </div>
    <div class="list-body">
        @if (Model.Items.Count == 0)
        {
            <partial name="_ListEmpty" model="emptyMessage" />
        }
        else
        {
            foreach (var item in Model.Items)
            {
                <div class="list-row" style="grid-template-columns:@cols">
                    <span data-label="Variété">
                        <a asp-action="Detail" asp-route-id="@item.VarieteId" class="list-link">@item.VarieteNom</a>
                    </span>
                    <span data-label="Code">@(item.Code ?? "—")</span>
                    <span data-label="Stock (L)" class="cell-bold cell-center">@item.StockHuile.ToString("N2")</span>
                    <span data-label="Statut">
                        @if (item.StockHuile <= 0)
                        {
                            <span class="badge badge-stock-rupture">Vide</span>
                        }
                        else
                        {
                            <span class="badge badge-ok">Disponible</span>
                        }
                    </span>
                    <span class="list-row-actions" data-label="Actions">
                        <a asp-action="Detail"
                           asp-route-id="@item.VarieteId"
                           class="btn btn-sm"
                           title="Historique des mouvements">
                            Historique
                        </a>
                    </span>
                </div>
            }
        }
    </div>
</div>

<partial name="_ListPagination" model="pagination" />
