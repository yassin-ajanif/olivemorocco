@model IntrantStockListViewModel
@{
    const string cols = "1.5fr 1fr 0.8fr 1fr auto minmax(5.5rem, auto)";
    const string emptyMessage = "Aucun intrant en stock — créez des intrants dans le catalogue.";
    var pagination = new ListPaginationViewModel
    {
        Page = Model.Page,
        TotalPages = Model.TotalPages,
        HasPrevious = Model.HasPrevious,
        HasNext = Model.HasNext,
        Search = Model.Search,
    };
}

<partial name="_DashboardAlerts" />

<div class="page-head">
    <p class="eyebrow">Stockage</p>
    <h1>Stock des intrants</h1>
    <p class="module-section">Quantités disponibles et alertes de réapprovisionnement</p>
</div>

<form method="get" asp-action="Index" class="list-toolbar stock-toolbar">
    <input type="search"
           class="list-search"
           name="search"
           value="@Model.Search"
           placeholder="Rechercher par nom…"
           autocomplete="off" />
</form>

<div class="list-wrap">
    <div class="list-header" style="grid-template-columns:@cols">
        <span>Nom</span>
        <span>Unité</span>
        <span class="cell-bold cell-center">Stock actuel</span>
        <span>Prix achat HT</span>
        <span>Actions</span>
    </div>
    <div class="list-body">
        @if (Model.Items.Count == 0)
        {
            <partial name="_ListEmpty" model="emptyMessage" />
        }
        else
        {
            foreach (var item in Model.Items)
            {
                <div class="list-row" style="grid-template-columns:@cols">
                    <span data-label="Nom">
                        <a asp-action="Detail" asp-route-id="@item.Id" class="list-link">@item.Nom</a>
                    </span>
                    <span data-label="Unité">@item.Unite</span>
                    <span data-label="Stock actuel" class="cell-bold cell-center">
                        @item.StockActuel.ToString("N0")
                    </span>
                    <span data-label="Prix achat HT">
                        @(item.PrixAchatHT?.ToString("N2") ?? "—")
                    </span>
                    <span class="list-row-actions" data-label="Actions">
                        <a asp-action="Detail"
                           asp-route-id="@item.Id"
                           class="btn btn-sm"
                           title="Historique des mouvements">
                            Historique
                        </a>
                    </span>
                </div>
            }
        }
    </div>
</div>

<partial name="_ListPagination" model="pagination" />
