@model IntrantListViewModel
@{
    const string cols = "2fr 1fr auto";
    const string emptyMessage = "Aucun intrant — cliquez sur Nouveau pour commencer.";
    var pagination = new ListPaginationViewModel
    {
        Page = Model.Page,
        TotalPages = Model.TotalPages,
        HasPrevious = Model.HasPrevious,
        HasNext = Model.HasNext,
        Search = Model.Search
    };
}

<partial name="_DashboardAlerts" />

<div class="page-head">
    <p class="eyebrow">Stockage</p>
    <h1>Intrants</h1>
    <p class="module-section">Engrais, compost et autres intrants agricoles</p>
</div>

<form method="get" asp-action="Index" class="list-toolbar">
    <a asp-action="Create" class="btn btn-primary">Nouveau</a>
    <input type="search"
           class="list-search"
           name="search"
           value="@Model.Search"
           placeholder="Rechercher par nom…"
           autocomplete="off" />
</form>

<div class="list-wrap">
    <div class="list-header" style="grid-template-columns:@cols">
        <span>Nom</span>
        <span>Unité</span>
        <span>Actions</span>
    </div>
    <div class="list-body">
        @if (Model.Items.Count == 0)
        {
            <partial name="_ListEmpty" model="emptyMessage" />
        }
        else
        {
            foreach (var intrant in Model.Items)
            {
                <div class="list-row" style="grid-template-columns:@cols">
                    <span data-label="Nom">
                        <a asp-action="Edit" asp-route-id="@intrant.Id" class="list-link">@intrant.Nom</a>
                    </span>
                    <span data-label="Unité">@intrant.Unite</span>
                    <span class="list-row-actions" data-label="Actions">
                        <a asp-action="Edit"
                           asp-route-id="@intrant.Id"
                           class="btn btn-icon"
                           title="Modifier"
                           aria-label="Modifier">
                            <partial name="~/Views/Shared/Icons/Edit.cshtml" />
                        </a>
                    </span>
                </div>
            }
        }
    </div>
</div>

<partial name="_ListPagination" model="pagination" />
