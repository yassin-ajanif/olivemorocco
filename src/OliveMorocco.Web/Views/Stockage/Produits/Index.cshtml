@model ProduitListViewModel
@{
    const string cols = "1fr 1.5fr 1fr 0.7fr 1fr 0.8fr auto minmax(5.5rem, auto)";
    const string emptyMessage = "Aucun produit — cliquez sur Nouveau pour commencer.";
    var pagination = new ListPaginationViewModel
    {
        Page = Model.Page,
        TotalPages = Model.TotalPages,
        HasPrevious = Model.HasPrevious,
        HasNext = Model.HasNext,
        Search = Model.Search
    };
}

<partial name="_DashboardAlerts" />

<div class="page-head">
    <p class="eyebrow"><partial name="_TrLabel" model="@("Stockage")" /></p>
    <h1><partial name="_TrLabel" model="@("Produits")" /></h1>
    <p class="module-section"><partial name="_TrLabel" model="@("Catalogue des produits vendus")" /></p>
</div>

<form method="get" asp-action="Index" class="list-toolbar">
    <a asp-action="Create" class="btn btn-primary"><partial name="_TrLabel" model="@("Nouveau")" /></a>
    <input type="search"
           class="list-search"
           name="search"
           value="@Model.Search"
           placeholder="Rechercher par réf., désignation ou code-barres…" data-tr-ar="@(Translations.For("Rechercher par réf., désignation ou code-barres…"))"
           autocomplete="off" />
</form>

<div class="list-wrap">
    <div class="list-header" style="grid-template-columns:@cols">
        <span><partial name="_TrLabel" model="@("Réf.")" /></span>
        <span><partial name="_TrLabel" model="@("Désignation")" /></span>
        <span><partial name="_TrLabel" model="@("Variété")" /></span>
        <span><partial name="_TrLabel" model="@("Unité")" /></span>
        <span class="cell-bold cell-center"><partial name="_TrLabel" model="@("P. vente HT")" /></span>
        <span><partial name="_TrLabel" model="@("Stock")" /></span>
        <span><partial name="_TrLabel" model="@("Statut")" /></span>
        <span><partial name="_TrLabel" model="@("Actions")" /></span>
    </div>
    <div class="list-body">
        @if (Model.Items.Count == 0)
        {
            <partial name="_ListEmpty" model="emptyMessage" />
        }
        else
        {
            foreach (var produit in Model.Items)
            {
                <div class="list-row" style="grid-template-columns:@cols">
                    <span data-label="Réf." data-label-ar="@(Translations.For("Réf."))">
                        <a asp-action="Edit" asp-route-id="@produit.Id" class="list-link">@produit.Reference</a>
                    </span>
                    <span data-label="Désignation" data-label-ar="@(Translations.For("Désignation"))">@produit.Designation</span>
                    <span data-label="Variété" data-label-ar="@(Translations.For("Variété"))">@produit.VarieteNom</span>
                    <span data-label="Unité" data-label-ar="@(Translations.For("Unité"))">@produit.Unite</span>
                    <span data-label="P. vente HT" data-label-ar="@(Translations.For("P. vente HT"))" class="cell-bold cell-center">@produit.PrixVenteHT.ToString("N2") DH</span>
                    <span data-label="Stock" data-label-ar="@(Translations.For("Stock"))">
                        @produit.StockActuel.ToString("N0")
                        @if (produit.StockBas)
                        {
                            <span class="badge badge-warn"><partial name="_TrLabel" model="@("Stock bas")" /></span>
                        }
                    </span>
                    <span data-label="Statut" data-label-ar="@(Translations.For("Statut"))">
                        @if (produit.Actif)
                        {
                            <span class="badge badge-ok"><partial name="_TrLabel" model="@("Actif")" /></span>
                        }
                        else
                        {
                            <span class="badge badge-warn"><partial name="_TrLabel" model="@("Inactif")" /></span>
                        }
                    </span>
                    <span class="list-row-actions" data-label="Actions" data-label-ar="@(Translations.For("Actions"))">
                        <a asp-action="Edit"
                           asp-route-id="@produit.Id"
                           class="btn btn-icon"
                           title="Modifier" data-tr-ar="@(Translations.For("Modifier"))"
                           aria-label="Modifier" data-tr-ar="@(Translations.For("Modifier"))">
                            <partial name="~/Views/Shared/Icons/Edit.cshtml" />
                        </a>
                        <form asp-action="ToggleActif" method="post" class="inline-form">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="id" value="@produit.Id" />
                            <input type="hidden" name="search" value="@Model.Search" />
                            <input type="hidden" name="page" value="@Model.Page" />
                            <button type="submit" class="btn btn-sm" title="@(produit.Actif ? "Désactiver" : "Activer")">
                                @(produit.Actif ? "Off" : "On")
                            </button>
                        </form>
                    </span>
                </div>
            }
        }
    </div>
</div>

<partial name="_ListPagination" model="pagination" />
