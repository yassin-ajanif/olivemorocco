@model SecteurListViewModel
@using System.Globalization
@{
    const string cols = "1.5fr 0.6fr 0.8fr 1.5fr auto";
    const string emptyMessage = "Aucun secteur — cliquez sur Nouveau pour commencer.";
    var pagination = new ListPaginationViewModel
    {
        Page = Model.Page,
        TotalPages = Model.TotalPages,
        HasPrevious = Model.HasPrevious,
        HasNext = Model.HasNext,
        Search = Model.Search
    };
}

<partial name="_DashboardAlerts" />

<div class="page-head">
    <p class="eyebrow"><partial name="_TrLabel" model="@("Stockage")" /></p>
    <h1><partial name="_TrLabel" model="@("Secteurs")" /></h1>
    <p class="module-section"><partial name="_TrLabel" model="@("Parcelles et secteurs de l'exploitation")" /></p>
</div>

<form method="get" asp-action="Index" class="list-toolbar">
    <a asp-action="Create" class="btn btn-primary"><partial name="_TrLabel" model="@("Nouveau")" /></a>
    <input type="search"
           class="list-search"
           name="search"
           value="@Model.Search"
           placeholder="Rechercher par nom ou code…" data-tr-ar="@(Translations.For("Rechercher par nom ou code…"))"
           autocomplete="off" />
</form>

<div class="list-wrap">
    <div class="list-header" style="grid-template-columns:@cols">
        <span><partial name="_TrLabel" model="@("Nom")" /></span>
        <span><partial name="_TrLabel" model="@("Code")" /></span>
        <span><partial name="_TrLabel" model="@("Superficie")" /></span>
        <span><partial name="_TrLabel" model="@("Variétés")" /></span>
        <span><partial name="_TrLabel" model="@("Actions")" /></span>
    </div>
    <div class="list-body">
        @if (Model.Items.Count == 0)
        {
            <partial name="_ListEmpty" model="emptyMessage" />
        }
        else
        {
            foreach (var secteur in Model.Items)
            {
                <div class="list-row" style="grid-template-columns:@cols">
                    <span data-label="Nom" data-label-ar="@(Translations.For("Nom"))">
                        <a asp-action="Edit" asp-route-id="@secteur.Id" class="list-link">@secteur.Nom</a>
                    </span>
                    <span data-label="Code" data-label-ar="@(Translations.For("Code"))">@(string.IsNullOrEmpty(secteur.Code) ? "—" : secteur.Code)</span>
                    <span data-label="Superficie" data-label-ar="@(Translations.For("Superficie"))">@secteur.SuperficieHectares.ToString("0.##", CultureInfo.CurrentCulture) ha</span>
                    <span data-label="Variétés" data-label-ar="@(Translations.For("Variétés"))">@secteur.VarieteSummary</span>
                    <span class="list-row-actions" data-label="Actions" data-label-ar="@(Translations.For("Actions"))">
                        <a asp-action="Edit"
                           asp-route-id="@secteur.Id"
                           class="btn btn-icon"
                           title="Modifier" data-tr-ar="@(Translations.For("Modifier"))"
                           aria-label="Modifier" data-tr-ar="@(Translations.For("Modifier"))">
                            <partial name="~/Views/Shared/Icons/Edit.cshtml" />
                        </a>
                    </span>
                </div>
            }
        }
    </div>
</div>

<partial name="_ListPagination" model="pagination" />
