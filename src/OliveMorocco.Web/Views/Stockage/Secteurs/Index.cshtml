@model SecteurListViewModel
@using System.Globalization
@{
    const string cols = "1.5fr 0.6fr 0.8fr 1.5fr auto";
    const string emptyMessage = "Aucun secteur — cliquez sur Nouveau pour commencer.";
    var pagination = new ListPaginationViewModel
    {
        Page = Model.Page,
        TotalPages = Model.TotalPages,
        HasPrevious = Model.HasPrevious,
        HasNext = Model.HasNext,
        Search = Model.Search
    };
}

<partial name="_DashboardAlerts" />

<div class="page-head">
    <p class="eyebrow">Stockage</p>
    <h1>Secteurs</h1>
    <p class="module-section">Parcelles et secteurs de l'exploitation</p>
</div>

<form method="get" asp-action="Index" class="list-toolbar">
    <a asp-action="Create" class="btn btn-primary">Nouveau</a>
    <input type="search"
           class="list-search"
           name="search"
           value="@Model.Search"
           placeholder="Rechercher par nom ou code…"
           autocomplete="off" />
</form>

<div class="list-wrap">
    <div class="list-header" style="grid-template-columns:@cols">
        <span>Nom</span>
        <span>Code</span>
        <span>Superficie</span>
        <span>Variétés</span>
        <span>Actions</span>
    </div>
    <div class="list-body">
        @if (Model.Items.Count == 0)
        {
            <partial name="_ListEmpty" model="emptyMessage" />
        }
        else
        {
            foreach (var secteur in Model.Items)
            {
                <div class="list-row" style="grid-template-columns:@cols">
                    <span data-label="Nom">
                        <a asp-action="Edit" asp-route-id="@secteur.Id" class="list-link">@secteur.Nom</a>
                    </span>
                    <span data-label="Code">@(string.IsNullOrEmpty(secteur.Code) ? "—" : secteur.Code)</span>
                    <span data-label="Superficie">@secteur.SuperficieHectares.ToString("0.##", CultureInfo.CurrentCulture) ha</span>
                    <span data-label="Variétés">@secteur.VarieteSummary</span>
                    <span class="list-row-actions" data-label="Actions">
                        <a asp-action="Edit"
                           asp-route-id="@secteur.Id"
                           class="btn btn-icon"
                           title="Modifier"
                           aria-label="Modifier">
                            <partial name="~/Views/Shared/Icons/Edit.cshtml" />
                        </a>
                    </span>
                </div>
            }
        }
    </div>
</div>

<partial name="_ListPagination" model="pagination" />
