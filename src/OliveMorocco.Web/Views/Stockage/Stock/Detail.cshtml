@model StockDetailViewModel
@using OliveMorocco.Domain.Enums
@{
    var p = Model.Produit;
    const string cols = "1.1fr 0.75fr 0.7fr 0.8fr 0.8fr 1fr minmax(0,1.2fr)";
    const string emptyMessage = "Aucun mouvement enregistré pour ce produit.";
    var ajustementOpen = !ViewData.ModelState.IsValid;
    var pagination = new ListPaginationViewModel
    {
        Page = Model.MouvementPage,
        TotalPages = Model.MouvementTotalPages,
        HasPrevious = Model.MouvementHasPrevious,
        HasNext = Model.MouvementHasNext,
        Id = p.Id,
    };
}

<partial name="_DashboardAlerts" />

<div class="page-head">
    <p class="eyebrow">Stockage · État du stock</p>
    <h1>@p.Designation</h1>
    <p class="module-section">@p.Reference · @p.VarieteNom</p>
    <a asp-action="Index" class="btn btn-sm">← Retour à la liste</a>
</div>

<div class="dash-panel stock-ajustement-panel@(ajustementOpen ? " is-open" : "")"
     id="stockAjustementPanel">
    <button type="button"
            class="stock-ajustement-toggle"
            aria-expanded="@(ajustementOpen ? "true" : "false")"
            aria-controls="stockAjustementBody">
        <span class="stock-ajustement-toggle-arrow" aria-hidden="true">@(ajustementOpen ? "▼" : "▶")</span>
        <span class="stock-panel-title">Ajustement manuel</span>
    </button>
    <div class="stock-ajustement-body"
         id="stockAjustementBody"
         @(!ajustementOpen ? "hidden" : null)>
        <p class="stock-panel-hint">Entrez une variation positive (entrée) ou négative (sortie).</p>
        <form asp-action="Ajustement"
              asp-route-id="@p.Id"
              asp-route-page="@Model.MouvementPage"
              method="post"
              class="stock-ajustement-form">
            @Html.AntiForgeryToken()
            <div asp-validation-summary="All" class="form-validation-summary"></div>
            <div class="stock-ajustement-row">
                <div class="form-field stock-ajustement-variation">
                    <label asp-for="Ajustement.Variation">Variation</label>
                    <input asp-for="Ajustement.Variation"
                           type="number"
                           step="1"
                           placeholder="Ex. 10 ou -5" />
                    <span asp-validation-for="Ajustement.Variation" class="field-validation-error"></span>
                </div>
                <div class="form-field stock-ajustement-note">
                    <label asp-for="Ajustement.Note">Note</label>
                    <input asp-for="Ajustement.Note"
                           type="text"
                           maxlength="500"
                           placeholder="Motif de l'ajustement (optionnel)" />
                    <span asp-validation-for="Ajustement.Note" class="field-validation-error"></span>
                </div>
                <div class="form-field stock-ajustement-submit">
                    <span class="stock-ajustement-submit-label" aria-hidden="true">&nbsp;</span>
                    <button type="submit" class="btn btn-primary">Enregistrer l'ajustement</button>
                </div>
            </div>
        </form>
    </div>
</div>

<div class="stock-mouvements-section">
    <h2 class="stock-panel-title">Historique des mouvements</h2>

    <div class="list-wrap">
        <div class="list-header" style="grid-template-columns:@cols">
            <span>Date</span>
            <span>Type</span>
            <span class="cell-center">Stock avant</span>
            <span class="cell-center">Quantité</span>
            <span class="cell-center">Stock après</span>
            <span>Origine</span>
            <span>Note</span>
        </div>
        <div class="list-body">
            @if (Model.Mouvements.Count == 0)
            {
                <partial name="_ListEmpty" model="emptyMessage" />
            }
            else
            {
                foreach (var m in Model.Mouvements)
                {
                    var qtyInbound = m.Type == TypeMouvement.Entree
                        || (m.Type == TypeMouvement.Ajustement && m.StockApres > m.StockAvant);
                    <div class="list-row" style="grid-template-columns:@cols">
                        <span data-label="Date">@m.Date.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</span>
                        <span data-label="Type">
                            @switch (m.Type)
                            {
                                case TypeMouvement.Entree:
                                    <span class="badge badge-ok">Entrée</span>
                                    break;
                                case TypeMouvement.Sortie:
                                    <span class="badge badge-warn">Sortie</span>
                                    break;
                                default:
                                    <span class="badge badge-gold">Ajustement</span>
                                    break;
                            }
                        </span>
                        <span data-label="Stock avant" class="cell-center">@m.StockAvant.ToString("N0")</span>
                        <span data-label="Quantité" class="cell-center cell-bold @(qtyInbound ? "stock-qty-in" : "stock-qty-out")">@(qtyInbound ? "+" : "-")@m.Quantite.ToString("N0")</span>
                        <span data-label="Stock après" class="cell-bold cell-center">@m.StockApres.ToString("N0")</span>
                        <span data-label="Origine">@m.OrigineLabel</span>
                        <span data-label="Note">@(string.IsNullOrWhiteSpace(m.Note) ? "—" : m.Note)</span>
                    </div>
                }
            }
        </div>
    </div>

</div>

<partial name="_ListPagination" model="pagination" />

@section Scripts {
    <script src="~/js/stock-detail.js" asp-append-version="true"></script>
}
