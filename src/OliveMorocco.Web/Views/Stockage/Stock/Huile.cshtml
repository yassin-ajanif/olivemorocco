@model StockHuileDetailViewModel
@{
    var v = Model.Variete;
    const string cols = "1.1fr 0.75fr 0.8fr 0.8fr 0.8fr 1fr minmax(0,1.2fr)";
    const string emptyMessage = "Aucun mouvement d'huile enregistré pour cette variété.";
    var ajustementOpen = !ViewData.ModelState.IsValid;
    var pagination = new ListPaginationViewModel
    {
        Page = Model.MouvementPage,
        TotalPages = Model.MouvementTotalPages,
        HasPrevious = Model.MouvementHasPrevious,
        HasNext = Model.MouvementHasNext,
        Id = v.VarieteId,
    };
}

<partial name="_DashboardAlerts" />

<div class="page-head">
    <p class="eyebrow"><partial name="_TrLabel" model="@("Stockage · Huile en vrac")" /></p>
    <h1>@v.VarieteNom</h1>
    <p class="module-section">
        Stock actuel : <strong>@v.StockHuile.ToString("N2") L</strong>@(v.Code is null ? "" : $" · {v.Code}")
    </p>
    <a asp-action="Index" asp-route-vue="huile" class="btn btn-sm"><partial name="_TrLabel" model="@("← Retour à la liste")" /></a>
</div>

<div class="dash-panel stock-ajustement-panel@(ajustementOpen ? " is-open" : "")"
     id="stockAjustementPanel">
    <button type="button"
            class="stock-ajustement-toggle"
            aria-expanded="@(ajustementOpen ? "true" : "false")"
            aria-controls="stockAjustementBody">
        <span class="stock-ajustement-toggle-arrow" aria-hidden="true">@(ajustementOpen ? "▼" : "▶")</span>
        <span class="stock-panel-title"><partial name="_TrLabel" model="@("Ajustement manuel")" /></span>
    </button>
    <div class="stock-ajustement-body"
         id="stockAjustementBody"
         @(!ajustementOpen ? "hidden" : null)>
        <p class="stock-panel-hint"><partial name="_TrLabel" model="@("Entrez une variation en litres : positive (entrée) ou négative (sortie).")" /></p>
        <form asp-action="HuileAjustement"
              asp-route-id="@v.VarieteId"
              asp-route-page="@Model.MouvementPage"
              method="post"
              class="stock-ajustement-form">
            @Html.AntiForgeryToken()
            <div asp-validation-summary="All" class="form-validation-summary"></div>
            <div class="stock-ajustement-row">
                <div class="form-field stock-ajustement-variation">
                    <label asp-for="Ajustement.Variation"><partial name="_TrLabel" model="@("Variation (L)")" /></label>
                    <input asp-for="Ajustement.Variation"
                           type="number"
                           step="1"
                           placeholder="Ex. 50 ou -12" data-tr-ar="@(Translations.For("Ex. 50 ou -12"))" />
                    <span asp-validation-for="Ajustement.Variation" class="field-validation-error"></span>
                </div>
                <div class="form-field stock-ajustement-note">
                    <label asp-for="Ajustement.Note"><partial name="_TrLabel" model="@("Note")" /></label>
                    <input asp-for="Ajustement.Note"
                           type="text"
                           maxlength="500"
                           placeholder="Motif de l'ajustement (optionnel)" data-tr-ar="@(Translations.For("Motif de l'ajustement (optionnel)"))" />
                    <span asp-validation-for="Ajustement.Note" class="field-validation-error"></span>
                </div>
                <div class="form-field stock-ajustement-submit">
                    <span class="stock-ajustement-submit-label" aria-hidden="true">&nbsp;</span>
                    <button type="submit" class="btn btn-primary"><partial name="_TrLabel" model="@("Enregistrer l'ajustement")" /></button>
                </div>
            </div>
        </form>
    </div>
</div>

<div class="stock-mouvements-section">
    <h2 class="stock-panel-title"><partial name="_TrLabel" model="@("Historique des mouvements")" /></h2>

    <div class="list-wrap">
        <div class="list-header" style="grid-template-columns:@cols">
            <span><partial name="_TrLabel" model="@("Date")" /></span>
            <span><partial name="_TrLabel" model="@("Type")" /></span>
            <span class="cell-center"><partial name="_TrLabel" model="@("Stock avant (L)")" /></span>
            <span class="cell-center"><partial name="_TrLabel" model="@("Quantité (L)")" /></span>
            <span class="cell-center"><partial name="_TrLabel" model="@("Stock après (L)")" /></span>
            <span><partial name="_TrLabel" model="@("Origine")" /></span>
            <span><partial name="_TrLabel" model="@("Note")" /></span>
        </div>
        <div class="list-body">
            @if (Model.Mouvements.Count == 0)
            {
                <partial name="_ListEmpty" model="emptyMessage" />
            }
            else
            {
                foreach (var m in Model.Mouvements)
                {
                    var qtyInbound = m.Type != TypeMouvement.Sortie;
                    <div class="list-row" style="grid-template-columns:@cols">
                        <span data-label="Date" data-label-ar="@(Translations.For("Date"))">@m.Date.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</span>
                        <span data-label="Type" data-label-ar="@(Translations.For("Type"))">
                            @switch (m.Type)
                            {
                                case TypeMouvement.Entree:
                                    <span class="badge badge-ok"><partial name="_TrLabel" model="@("Entrée")" /></span>
                                    break;
                                case TypeMouvement.Sortie:
                                    <span class="badge badge-warn"><partial name="_TrLabel" model="@("Sortie")" /></span>
                                    break;
                                default:
                                    <span class="badge badge-gold"><partial name="_TrLabel" model="@("Ajustement")" /></span>
                                    break;
                            }
                        </span>
                        <span data-label="Stock avant" data-label-ar="@(Translations.For("Stock avant"))" class="cell-center">@m.StockAvant.ToString("N2")</span>
                        <span data-label="Quantité" data-label-ar="@(Translations.For("Quantité"))" class="cell-center cell-bold @(qtyInbound ? "stock-qty-in" : "stock-qty-out")">@(qtyInbound ? "+" : "-")@m.Quantite.ToString("N2")</span>
                        <span data-label="Stock après" data-label-ar="@(Translations.For("Stock après"))" class="cell-bold cell-center">@m.StockApres.ToString("N2")</span>
                        <span data-label="Origine" data-label-ar="@(Translations.For("Origine"))">
                            @if (m.OrigineType == "Pressage" && m.OrigineId.HasValue)
                            {
                                <a href="/@OliveMorocco.Web.Routing.AppSections.Operationnel/Pressages/Edit/@m.OrigineId" class="list-link">@m.OrigineLabel</a>
                            }
                            else if (m.OrigineType == "Remplissage" && m.OrigineId.HasValue)
                            {
                                <a href="/@OliveMorocco.Web.Routing.AppSections.Operationnel/Remplissages/Edit/@m.OrigineId" class="list-link">@m.OrigineLabel</a>
                            }
                            else
                            {
                                @m.OrigineLabel
                            }
                        </span>
                        <span data-label="Note" data-label-ar="@(Translations.For("Note"))">@(string.IsNullOrWhiteSpace(m.Note) ? "—" : m.Note)</span>
                    </div>
                }
            }
        </div>
    </div>

</div>

<partial name="_ListPagination" model="pagination" />

@section Scripts {
    <script src="~/js/stock-detail.js" asp-append-version="true"></script>
}
