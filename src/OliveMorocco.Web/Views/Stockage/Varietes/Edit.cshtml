@model VarieteFormViewModel

<partial name="_DashboardAlerts" />

<div class="page-head">
    <p class="eyebrow">Stockage · Variétés</p>
    <h1>@Model.Nom</h1>
</div>

<div class="form-panel">
    <partial name="_VarieteForm" model="Model" />
</div>

<form asp-action="Delete"
      asp-route-id="@Model.Id"
      method="post"
      class="form-delete"
      onsubmit="return confirm('Supprimer cette variété ?');">
    @Html.AntiForgeryToken()
    <button type="submit" class="btn btn-danger">Supprimer</button>
</form>
