@model VarieteListViewModel
@{
    const string cols = "2fr 1fr 1.5fr 1fr auto";
    const string emptyMessage = "Aucune variété — cliquez sur Nouveau pour commencer.";
    var pagination = new ListPaginationViewModel
    {
        Page = Model.Page,
        TotalPages = Model.TotalPages,
        HasPrevious = Model.HasPrevious,
        HasNext = Model.HasNext,
        Search = Model.Search
    };
}

<partial name="_DashboardAlerts" />

<div class="page-head">
    <p class="eyebrow"><partial name="_TrLabel" model="@("Stockage")" /></p>
    <h1><partial name="_TrLabel" model="@("Variétés")" /></h1>
    <p class="module-section"><partial name="_TrLabel" model="@("Picholine, Beldi et autres variétés d'olive")" /></p>
</div>

<form method="get" asp-action="Index" class="list-toolbar">
    <a asp-action="Create" class="btn btn-primary"><partial name="_TrLabel" model="@("Nouveau")" /></a>
    <input type="search"
           class="list-search"
           name="search"
           value="@Model.Search"
           placeholder="Rechercher par nom, code ou région…" data-tr-ar="@(Translations.For("Rechercher par nom, code ou région…"))"
           autocomplete="off" />
</form>

<div class="list-wrap">
    <div class="list-header" style="grid-template-columns:@cols">
        <span><partial name="_TrLabel" model="@("Nom")" /></span>
        <span><partial name="_TrLabel" model="@("Code")" /></span>
        <span><partial name="_TrLabel" model="@("Région d'origine")" /></span>
        <span class="cell-bold cell-center"><partial name="_TrLabel" model="@("Stock huile (L)")" /></span>
        <span><partial name="_TrLabel" model="@("Actions")" /></span>
    </div>
    <div class="list-body">
        @if (Model.Items.Count == 0)
        {
            <partial name="_ListEmpty" model="emptyMessage" />
        }
        else
        {
            foreach (var variete in Model.Items)
            {
                <div class="list-row" style="grid-template-columns:@cols">
                    <span data-label="Nom" data-label-ar="@(Translations.For("Nom"))">
                        <a asp-action="Edit" asp-route-id="@variete.Id" class="list-link">@variete.Nom</a>
                    </span>
                    <span data-label="Code" data-label-ar="@(Translations.For("Code"))">@(variete.Code ?? "—")</span>
                    <span data-label="Région" data-label-ar="@(Translations.For("Région"))">@(variete.RegionOrigine ?? "—")</span>
                    <span data-label="Stock huile (L)" data-label-ar="@(Translations.For("Stock huile (L)"))" class="cell-bold cell-center">
                        <a href="/@OliveMorocco.Web.Routing.AppSections.Stockage/Stock/Huile/@variete.Id" class="list-link">@variete.StockHuile.ToString("N2")</a>
                    </span>
                    <span class="list-row-actions" data-label="Actions" data-label-ar="@(Translations.For("Actions"))">
                        <a asp-action="Edit"
                           asp-route-id="@variete.Id"
                           class="btn btn-icon"
                           title="Modifier" data-tr-ar="@(Translations.For("Modifier"))"
                           aria-label="Modifier" data-tr-ar="@(Translations.For("Modifier"))">
                            <partial name="~/Views/Shared/Icons/Edit.cshtml" />
                        </a>
                    </span>
                </div>
            }
        }
    </div>
</div>

<partial name="_ListPagination" model="pagination" />
