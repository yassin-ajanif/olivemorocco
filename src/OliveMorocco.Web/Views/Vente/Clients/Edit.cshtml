@model ClientFormViewModel

<partial name="_DashboardAlerts" />

<div class="page-head">
    <p class="eyebrow"><partial name="_TrLabel" model="@("Vente · Clients")" /></p>
    <h1>@Model.Nom</h1>
    <p class="form-ref"><partial name="_TrLabel" model="@("Réf. client")" /> <strong>#@Model.Id</strong></p>
</div>

<div class="form-panel">
    <partial name="_ClientForm" model="Model" />
</div>

<form asp-action="Delete"
      asp-route-id="@Model.Id"
      method="post"
      class="form-delete"
      onsubmit="return confirm('Supprimer ce client ?');">
    @Html.AntiForgeryToken()
    <button type="submit" class="btn btn-danger"><partial name="_TrLabel" model="@("Supprimer")" /></button>
</form>
