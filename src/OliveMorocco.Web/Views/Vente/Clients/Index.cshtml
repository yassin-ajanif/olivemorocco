@model ClientListViewModel
@{
    const string cols = "2fr 1fr 1fr auto minmax(5.5rem, auto)";
    const string emptyMessage = "Aucun enregistrement — cliquez sur Nouveau pour commencer.";
    var pagination = new ListPaginationViewModel
    {
        Page = Model.Page,
        TotalPages = Model.TotalPages,
        HasPrevious = Model.HasPrevious,
        HasNext = Model.HasNext,
        Search = Model.Search
    };
}

<partial name="_DashboardAlerts" />

<div class="page-head">
    <p class="eyebrow">Vente</p>
    <h1><partial name="_TrLabel" model="@("Clients")" /></h1>
    <p class="module-section"><partial name="_TrLabel" model="@("Restaurateurs, importateurs, épiciers")" /></p>
</div>

<form method="get" asp-action="Index" class="list-toolbar">
    <a asp-action="Create" class="btn btn-primary"><partial name="_TrLabel" model="@("Nouveau")" /></a>
    <input type="search"
           class="list-search"
           name="search"
           value="@Model.Search"
           placeholder="Rechercher…"
           autocomplete="off" />
</form>

<div class="list-wrap">
    <div class="list-header" style="grid-template-columns:@cols">
        <span><partial name="_TrLabel" model="@("Nom")" /></span>
        <span><partial name="_TrLabel" model="@("ICE")" /></span>
        <span><partial name="_TrLabel" model="@("Ville")" /></span>
        <span><partial name="_TrLabel" model="@("Actif")" /></span>
        <span><partial name="_TrLabel" model="@("Actions")" /></span>
    </div>
    <div class="list-body">
        @if (Model.Items.Count == 0)
        {
            <partial name="_ListEmpty" model="emptyMessage" />
        }
        else
        {
            foreach (var client in Model.Items)
            {
                <div class="list-row" style="grid-template-columns:@cols">
                    <span data-label="Nom">
                        <a asp-action="Edit" asp-route-id="@client.Id" class="list-link">@client.Nom</a>
                    </span>
                    <span data-label="ICE">@client.ICE</span>
                    <span data-label="Ville">@client.Ville</span>
                    <span data-label="Actif">
                        @if (client.Actif)
                        {
                            <span class="badge badge-ok"><partial name="_TrLabel" model="@("Actif")" /></span>
                        }
                        else
                        {
                            <span class="badge badge-warn"><partial name="_TrLabel" model="@("Inactif")" /></span>
                        }
                    </span>
                    <span class="list-row-actions" data-label="Actions">
                        <a asp-action="Edit"
                           asp-route-id="@client.Id"
                           class="btn btn-icon"
                           title="Modifier"
                           aria-label="Modifier">
                            <partial name="~/Views/Shared/Icons/Edit.cshtml" />
                        </a>
                        <form asp-action="ToggleActif" method="post" class="inline-form">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="id" value="@client.Id" />
                            <input type="hidden" name="search" value="@Model.Search" />
                            <input type="hidden" name="page" value="@Model.Page" />
                            <button type="submit" class="btn btn-sm" title="@(client.Actif ? "Désactiver" : "Activer")">
                                @(client.Actif ? "Off" : "On")
                            </button>
                        </form>
                    </span>
                </div>
            }
        }
    </div>
</div>

<partial name="_ListPagination" model="pagination" />
