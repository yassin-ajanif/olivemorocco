@model DevisFormViewModel
@{
    var title = Model.IsEdit ? "Modifier le devis" : "Nouveau devis";
}

<partial name="_DashboardAlerts" />

<div class="page-head">
    <p class="eyebrow">Vente</p>
    <h1>@title</h1>
    <p class="form-ref">Référence <strong>@Model.Numero</strong></p>
</div>

<div class="form-toolbar">
    <a asp-action="Index" class="btn">← Retour</a>
    <button type="submit" form="devis-form" class="btn btn-primary">Enregistrer</button>
</div>

@if (Model.IsEdit)
{
    <form asp-action="Edit" asp-route-id="@Model.Id" method="post" id="devis-form">
        @Html.AntiForgeryToken()
        <partial name="_DevisFormBody" model="Model" />
    </form>

    <form asp-action="Delete"
          asp-route-id="@Model.Id"
          method="post"
          class="form-delete"
          onsubmit="return confirm('Supprimer ce devis ?');">
        @Html.AntiForgeryToken()
        <button type="submit" class="btn btn-danger">Supprimer</button>
    </form>
}
else
{
    <form asp-action="Create" method="post" id="devis-form">
        @Html.AntiForgeryToken()
        <partial name="_DevisFormBody" model="Model" />
    </form>
}

@section Scripts {
    <script src="~/js/document-totals.js" asp-append-version="true"></script>
    <script src="~/js/vente-document-form.js" asp-append-version="true"></script>
    <script src="~/js/devis-form.js" asp-append-version="true"></script>
}
