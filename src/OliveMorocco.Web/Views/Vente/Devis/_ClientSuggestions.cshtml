@model IReadOnlyList<ClientSelectItem>

@if (Model.Count == 0)
{
    <p class="doc-suggest-empty">Aucun client trouvé.</p>
}
else
{
    <ul class="doc-suggest-list">
        @foreach (var client in Model)
        {
            <li>
                <button type="button"
                        class="client-suggestion doc-suggest-item"
                        data-client-id="@client.Id"
                        data-client-nom="@client.Nom">
                    @client.Nom
                </button>
            </li>
        }
    </ul>
}
